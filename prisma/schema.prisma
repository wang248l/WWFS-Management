generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SSO mirror of CRM users. Auth happens entirely in CRM; we lazily upsert a row
// here on first sight so role checks and audit trails have a local reference.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  role         String   @default("member") // admin | hr | manager | member
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A business unit Wallace wants to monitor (销售部 / 市场部 / 运营部 ...).
model Department {
  id        String   @id @default(cuid())
  key       String   @unique // sales | marketing | operations
  name      String // 销售部
  icon      String? // emoji shown on the dashboard
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metrics Metric[]

  @@index([order])
}

// A KPI definition (销售转化率 / 流量 / 私信数量 / 开口成本 ...). The actual
// monthly numbers live in MetricValue, one row per (metric, month).
model Metric {
  id           String  @id @default(cuid())
  key          String  @unique // sales_conversion_rate | traffic | dm_count | cost_per_open
  name         String // 销售转化率
  unit         String? // % | 个 | 次 | $ — shown after the value
  // Which direction is "good" — drives the green/red colouring of the MoM delta.
  betterWhen   String  @default("up") // up | down
  // How to render the value: number | percent | currency
  format       String  @default("number")
  description  String? // tooltip / what this measures and how it's collected
  // How this metric is normally fed: manual | cron | crm | marketing
  defaultSource String @default("manual")
  order        Int     @default(0)
  departmentId String

  department Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  values     MetricValue[]

  @@index([departmentId, order])
}

// One KPI reading for one calendar month. `period` is "YYYY-MM" (the month the
// number describes). Upsert key is (metricId, period) so re-ingesting a month
// overwrites rather than stacking duplicates — month-over-month is then just
// "this period row minus the previous period row".
model MetricValue {
  id        String   @id @default(cuid())
  metricId  String
  period    String // "YYYY-MM"
  value     Float
  source    String   @default("manual") // manual | cron | crm | marketing
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metric Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, period])
  @@index([period])
}

// ---- 团队看板（2026-10-16 Wallace：「一个看板就能完成……主要检查员工和 AI agent 的 input」）----

// 一个要盯的人。行为数据不存在这里：每次打开看板时去 CRM / Marketing 现拉，
// 按 matchName（不分大小写的子串）认出是 CRM / Marketing 里的哪个账号。
model Staff {
  id                String   @id @default(cuid())
  name              String   @unique // Amelia
  // 用来在 CRM 用户名/邮箱、Marketing 显示名里认人；空 = 用 name
  matchName         String?
  role              String? // 出镜顾问 / 运营 ...
  // 每周拍摄分钟目标（提词器录制时长），0 = 不考核拍摄
  weeklyFilmMinutes Int      @default(0)
  // WWFS办公室：所在部门 + 自己的工作空间（点进去打开的系统）
  department        String?
  workspaceUrl      String?
  active            Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 一个 AI agent：谁、干什么、多久该跑一次。以后加 agent 就是加一行
// （看板「管理名单」页，或 agent 第一次打卡时自动登记）。
model Agent {
  id         String     @id @default(cuid())
  key        String     @unique // mac | ryzen —— 打卡时用的名字
  name       String // MAC
  duty       String? // 职责：同步脚本到 Google Drive、剪辑、手机发布 ...
  host       String? // 跑在哪台机器上
  schedule   String? // 人话排程：每天 9:00 / 每 10 分钟
  // 超过 everyHours + graceHours 没动静就算「超时」
  everyHours Float      @default(24)
  graceHours Float      @default(2)
  // Marketing 里这台机器用的 API 钥匙名（AgentToken.label，子串匹配）——
  // 钥匙最后使用时间也算一次「活着」的信号，agent 不用改代码就能被看到
  tokenMatch String?
  // WWFS办公室（2026-11-03 Wallace：「每个人负责一个单独的工作空间」「Mark 的工作空间就是 marketing 网站」）
  department   String? // 运营部 / 市场部 / 增员部 ...
  title        String? // 工牌上的头衔：社交媒体总运营
  tags         String? // 职责标签，逗号分隔：出稿,分配,数据分析（工位上名字旁边显示）
  avatar       String? // emoji
  workspaceUrl String? // 他自己的工作空间
  workspaceName String?
  persona      String? // 在线对话时的人设与边界（给 Claude 的 system prompt）
  // 培训（2026-11-03 Wallace：「培训的过程就是用 Claude 去改这些 agent 的 skill，我会给每一个员工建立一个 project」）
  skills       String? // wang248l/agent-skills 里的文件夹，逗号分隔：wwfs-edit-koubo,wwfs-publish-shortvideo
  projectUrl   String? // 这个员工的培训 project 链接；空 = 待建
  active     Boolean    @default(true)
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  runs       AgentRun[]
  tasks      AgentTask[]
  messages   AgentMessage[]
}

// 看板上的一张卡：谁在做什么。agent 自己也能用 POST /api/agents/task 改。
model AgentTask {
  id        String   @id @default(cuid())
  agentId   String
  title     String
  status    String   @default("todo") // todo | doing | blocked | handoff（留资客户移交销售）| done
  note      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

// 老板在办公室里跟某个 agent 说的话、agent 的回答。
// agent 值班时用 GET /api/agents/inbox 取未读，POST /api/agents/reply 回复。
model AgentMessage {
  id        String    @id @default(cuid())
  agentId   String
  fromRole  String // owner | agent
  // 2026-11-03 Wallace：「告诉 Chase 改一下剪辑方法……完成不了就报错，第二天请求跟我开会，或者随时找我」
  // owner: chat 聊天 | instruction 交给他做（Mac 上的 runner 会执行）
  // agent: chat | progress 进度/完成 | blocker 卡住了 | meeting 请求开会
  kind      String    @default("chat")
  urgent    Boolean   @default(false) // blocker/meeting：true = 随时找老板，false = 第二天开会
  taskId    String? // 对应看板上的卡
  text      String
  readAt    DateTime? // owner 消息：agent 取走的时间
  resolvedAt DateTime? // blocker/meeting：老板点了「已处理」
  createdAt DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

// agent 每跑完一次打一次卡：POST /api/agents/run
model AgentRun {
  id          String    @id @default(cuid())
  agentId     String
  task        String? // 这次干的是哪件事
  status      String    @default("ok") // ok | error | running
  summary     String? // 一句话：干出了什么
  outputCount Int? // 产出数量（发了几条、剪了几个）
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

// 线上宣发每日数字（2026-11-03 Wallace：「宣发的工作都是线上的，完全不涉及销售」）。
// Mark / Leo 每天报一次：POST /api/agents/metrics，同一天重报覆盖。
model PromoDaily {
  id          String   @id @default(cuid())
  agentKey    String // mark | leo
  date        String // "YYYY-MM-DD"
  posts       Int?   // 当天发了几条
  impressions Int?   // 曝光
  followers   Int?   // 新增粉丝
  dms         Int?   // 私信
  leads       Int?   // 留了联系方式（→ 看板「移交销售」）
  signups     Int?   // 网课报名
  updatedAt   DateTime @updatedAt

  @@unique([agentKey, date])
}

// 网站设置（2026-11-06：办公室读 AI 工作日志要一把 Marketing 只读钥匙，服务器 .env 里没配；
// 老板在 /settings 页面贴一次就行，存这里，环境变量优先）。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
