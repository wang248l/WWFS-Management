# SQLite database file path
DATABASE_URL="file:./dev.db"

# JWT secret used to verify the shared SSO session cookie.
# MUST be identical to WWFS-CRM's JWT_SECRET, otherwise SSO breaks silently.
AUTH_SECRET="change-me-to-match-crm-jwt-secret"

# Set to ".wallacewang.ca" in production so the JWT cookie is shared across
# all *.wallacewang.ca subdomains (SSO). Leave empty for local dev.
COOKIE_DOMAIN=""

# Comma-separated roles allowed into the console. Default: admin only.
# Extend to "admin,hr,manager" once CRM issues those roles.
ALLOWED_ROLES="admin"

# Bearer token for POST /api/ingest. The month-end Claude scheduled task
# uploads platform metrics with `Authorization: Bearer <INGEST_TOKEN>`.
# Leave empty to disable the ingest endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=""

# Phase-2 live pulls from sister apps (read-only).
CRM_API_BASE="https://crm.wallacewang.ca"
CRM_API_KEY=""
